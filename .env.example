# Budjetame production secrets. Copy to .env and fill in — or run
# scripts/oracle-provision.sh, which generates the secrets for you.
#
# NOTE: the seed account is created only when the database is empty, at first
# boot. Set these correctly before the first `docker compose up`; changing
# them afterwards does not change the seeded login.

# Postgres password (the backend connects to `db` over the internal network,
# so only this random string matters — no public exposure).
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24

# JWT signing secret — openssl rand -hex 32
BUDJETAME_JWT_SECRET=openssl-rand-hex-32

# JWT session length in minutes. Optional: when absent, compose defaults to
# 129600 (90 days) so the Android app's users don't re-login daily.
BUDJETAME_JWT_EXPIRE_MINUTES=129600

# The single login identity seeded at first boot. No registration path.
BUDJETAME_SEED_ACCOUNT_EMAIL=you@example.com
BUDJETAME_SEED_ACCOUNT_PASSWORD=choose-a-real-password

# The site's hostname(s) — Caddy serves the app on this address over HTTPS
# (Let's Encrypt, automatic). Per environment:
#   prod:  budjetame.de, www.budjetame.de   (www redirects to the apex)
#   dev:   dev.budjetame.de
#   stage: stage.budjetame.de
# Point each name's DNS A record at the environment's VM before first boot.
DOMAIN=budjetame.de
