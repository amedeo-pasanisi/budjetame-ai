# Map picker provider (issue #27): "google" | "leaflet" (default, free, no key).
# When "google", VITE_GOOGLE_MAPS_API_KEY below is required.
VITE_MAP_PROVIDER=leaflet

# Google Maps JavaScript API + Places API key. NEVER commit a real key; create
# one via frontend/scripts/google-maps-wizard.sh (needs a Google Cloud billing
# account). Leave empty while running on the Leaflet picker.
VITE_GOOGLE_MAPS_API_KEY=
